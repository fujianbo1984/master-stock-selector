[Unit]
Description=Roll up and prune MasterStock access logs
After=masterstock-backup.service

[Service]
Type=oneshot
User=masterstock
Group=masterstock
WorkingDirectory=/opt/masterstock
EnvironmentFile=/etc/masterstock/masterstock.env
Environment=MASTERSTOCK_USER_DATABASE=/var/lib/masterstock/users.sqlite3
Environment=MASTERSTOCK_ACCESS_LOG_RETENTION_DAYS=90
ExecStart=/opt/masterstock/scripts/manage_users.sh access-log-maintain --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/masterstock
