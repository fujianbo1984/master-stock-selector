[Unit]
Description=MasterStock web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=masterstock
Group=masterstock
WorkingDirectory=/opt/masterstock
EnvironmentFile=/etc/masterstock/masterstock.env
ExecStart=/opt/masterstock/.venv/bin/masterstock web --host 127.0.0.1 --port 8000 --market-database /var/lib/masterstock/market.sqlite3 --watchlist-database /var/lib/masterstock/master_watchlist.sqlite3 --user-database /var/lib/masterstock/users.sqlite3
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/masterstock

[Install]
WantedBy=multi-user.target
