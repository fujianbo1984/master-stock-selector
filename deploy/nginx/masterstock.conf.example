limit_req_zone $binary_remote_addr zone=masterstock_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name stocks.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stocks.example.com;

    ssl_certificate /etc/letsencrypt/live/stocks.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stocks.example.com/privkey.pem;

    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location = /login {
        limit_req zone=masterstock_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
