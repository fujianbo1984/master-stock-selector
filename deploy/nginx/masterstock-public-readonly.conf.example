server {
    listen 8888 default_server;
    listen [::]:8888 default_server;
    server_name _;
    server_tokens off;

    # Keep the constrained public endpoint usable on limited bandwidth.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    client_max_body_size 64k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location = / {
        return 307 /a/daily;
    }

    location ^~ /static/ {
        limit_except GET HEAD {
            deny all;
        }

        root /opt/masterstock/src/master_stock_selector/web;
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }

    location = /healthz {
        limit_except GET HEAD {
            deny all;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        add_header Cache-Control "no-store" always;
    }

    location = /favicon.ico {
        limit_except GET HEAD {
            deny all;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        add_header Cache-Control "public, max-age=86400" always;
    }

    # The public JSON data is derived from daily facts. A short browser cache
    # avoids repeated chart transfers while still refreshing during the day.
    location ~ ^/api/a/(?:stocks/[^/]+/chart|watchlist/[^/]+|industries/[^/]+(?:/[^/]+)?|indices/[^/]+)$ {
        limit_except GET HEAD {
            deny all;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=300, stale-while-revalidate=60" always;
    }

    # Strict HTML allowlist. Authentication headers are stripped so mixed
    # public/private FastAPI pages always render anonymously.
    location ~ ^/a/(?:daily|industries|indices|runs|industries/[^/]+/chart|stocks/[^/]+(?:/(?:chart|realtime))?)$ {
        limit_except GET HEAD {
            deny all;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=30, stale-while-revalidate=60" always;
    }

    # Everything not explicitly public is private and reachable only through
    # the SSH tunnel to FastAPI's loopback listener.
    location / {
        return 404;
    }
}
