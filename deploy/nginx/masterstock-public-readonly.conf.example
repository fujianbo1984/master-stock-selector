server {
    listen 8888 default_server;
    listen [::]:8888 default_server;
    server_name _;
    server_tokens off;

    client_max_body_size 64k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Cache-Control "no-store" always;

    location = / {
        return 307 /a/daily;
    }

    # Strict allowlist for public facts and assets. Authentication headers are
    # stripped so mixed public/private FastAPI pages always render anonymously.
    location ~ ^/(?:favicon\.ico|static/.*|healthz|a/(?:daily|industries|indices|runs|industries/[^/]+/chart|stocks/[^/]+(?:/chart)?)|api/a/(?:stocks/[^/]+/chart|watchlist/[^/]+|industries/[^/]+(?:/[^/]+)?|indices/[^/]+))$ {
        limit_except GET HEAD {
            deny all;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
    }

    # Everything not explicitly public is private and reachable only through
    # the SSH tunnel to FastAPI's loopback listener.
    location / {
        return 404;
    }
}
