# Include this inside the HTTPS server block for books.longchangwudao.cn.
# It is intentionally scoped to the member-library virtual host only.
location ^~ /upload/ {
    proxy_pass http://127.0.0.1:5001/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# Kavita is not modified. The menu script is injected at the reverse proxy and
# independently verifies Admin in the browser; the upload service verifies it again.
sub_filter_once on;
sub_filter_types text/html;
sub_filter '</head>' '<script src="/upload/bookupload-menu.js" defer></script></head>';
proxy_set_header Accept-Encoding "";
